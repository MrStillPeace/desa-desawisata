# ==============================================================================
# Konfigurasi Environment Variable: Desa Wisata Lembah Asri AI Assistant
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================================

# Konfigurasi Database PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=desawisata
DATABASE_URL=postgresql://app:app@localhost:5432/desawisata

# Tanggal referensi untuk perhitungan aturan pembatalan H-n
REFERENCE_DATE=2026-11-17

# Token Telegram Bot dari @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Kredensial LLM (OpenAI-compatible / Sumopod)
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_MODEL=YOUR_LLM_MODEL_HERE

# Direktori Dokumen PDF & ChromaDB Vector Store
DOCS_DIR=docs
CHROMA_PATH=data/chroma
